# TeamT — HSMnT/AIBUNKER 것과 별개의 전용 자원. 실제 값은 .env (커밋 금지)
# TiDB Cloud: TeamT 전용 클러스터 (HSMnT 클러스터와 분리)
# Cloudflare R2: TeamT 전용 버킷
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=teamt
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# 로그인 — 세션 쿠키 서명 키(무작위 32바이트 hex). 가입은 초대장(invites 표)으로만 된다.
SESSION_SECRET=
