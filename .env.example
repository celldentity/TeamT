# TeamT — 실제 값은 .env (커밋 금지).
# 팀원은 관리자가 따로 전달한 «테스트 환경» 값만 쓴다. 운영 값은 받지도, 쓰지도 않는다.
# APP_ENV=test 가 없으면 scripts/dev.js 가 실행을 거부한다(운영 DB 에 실수로 붙는 것을 막는 안전장치).
APP_ENV=test

# TiDB (테스트 DB — teamt_test 에만 권한이 있는 사용자)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=teamt_test

# Cloudflare R2 (테스트 버킷 teamt-test 하나에만 쓰는 키)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=teamt-test
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# 로그인 — 세션 쿠키 서명 키(무작위 32바이트 hex). 가입은 초대장(invites 표)으로만 된다.
SESSION_SECRET=
